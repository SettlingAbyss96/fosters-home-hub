+# Phrases that end a conversation, as Whisper writes them (fosters-home-hub patch)
+_CLOSING = re.compile(
+    r"^(no,? )?(thanks|thank you|that'?s (all|it|everything)|that('ll| will) be (all|it)|nothing( else)?|"
+    r"i'?m good|i'?m all set|all good|we'?re (good|done)|never ?mind|perfect|great|awesome|cheers|got it|"
+    r"sounds good|good ?night|night|no|"
+    # and what Whisper (or a YouTube video on the TV) produces out of noise
+    r"thanks for watching|thank you for watching|please subscribe|subscribe|bye( bye)?|you)"
+    r"( (jarvis|sir|very much|so much|for now|thanks|thank you|i appreciate (it|that)))*$")
+# Signs Jarvis didn't manage it, so the person probably isn't done
+_TROUBLE = re.compile(
+    r"\b(sorry|didn'?t catch|couldn'?t|can'?t|not sure|did you mean|which one|no reading|unable|"
+    r"don'?t have|i'?m afraid)\b")
+
+
+def _is_no_reply(speech: str) -> bool:
+    norm = re.sub(r"[^a-z ]", " ", (speech or "").lower())
+    return " ".join(norm.split()) in ("no reply", "")
+
+
+def _is_closing(text: str) -> bool:
+    norm = re.sub(r"[^a-z' ]", " ", (text or "").lower())
+    return bool(_CLOSING.match(" ".join(norm.split())))
