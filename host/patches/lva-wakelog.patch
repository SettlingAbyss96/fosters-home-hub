+class _WakeLog:
+    """Writes down every wake word that came close and every one that fired, with how close.
+
+    Without it a missed "Hey Jarvis" leaves nothing behind, and there's no telling a quiet room from
+    a deaf microphone from a model that just didn't like it. Every 15 minutes it also writes the
+    loudest sound the mic heard, so a dead mic shows up as a number instead of a mystery.
+    """
+
+    EPISODE = 1.5  # seconds of quiet that end one "Hey Jarvis"
+    REPORT = 15 * 60
+
+    def __init__(self) -> None:
+        self.peak: dict = {}
+        self.until: dict = {}
+        self.fired: dict = {}
+        self.threshold: dict = {}
+        self.loudest = -120.0
+        self.close_calls = 0
+        self.wakes = 0
+        self.next_report = time.monotonic() + self.REPORT
+
+    def level(self, audio_chunk: bytes) -> None:
+        samples = np.frombuffer(audio_chunk, dtype=np.int16).astype(np.float32)
+        if samples.size:
+            rms = float(np.sqrt(np.mean(samples * samples)))
+            self.loudest = max(self.loudest, 20 * np.log10(max(rms, 1.0) / 32768))
+        now = time.monotonic()
+        self._close_episodes(now)
+        if now >= self.next_report:
+            _LOGGER.info(
+                "wake log: loudest %.0f dBFS in the last 15 min, %d wake(s), %d close call(s)",
+                self.loudest, self.wakes, self.close_calls,
+            )
+            self.loudest, self.close_calls, self.wakes = -120.0, 0, 0
+            self.next_report = now + self.REPORT
+
+    def see(self, index: int, prob: float, threshold: float) -> None:
+        if prob < max(0.1, threshold * 0.45):
+            return
+        self.peak[index] = max(self.peak.get(index, 0.0), prob)
+        self.threshold[index] = threshold
+        self.until[index] = time.monotonic() + self.EPISODE
+
+    def woke(self, index: int, muted: bool) -> None:
+        self.fired[index] = "muted" if muted else "woke"
+
+    def _close_episodes(self, now: float) -> None:
+        for index in [i for i, t in self.until.items() if now > t]:
+            fired = self.fired.pop(index, None)
+            peak, threshold = self.peak.pop(index), self.threshold.pop(index)
+            del self.until[index]
+            if fired:
+                self.wakes += 1
+                _LOGGER.info("wake word %d %s: peak %.2f, needs %.2f", index + 1, fired, peak, threshold)
+            else:
+                self.close_calls += 1
+                _LOGGER.info("wake word %d close call: peak %.2f, needs %.2f", index + 1, peak, threshold)
+
+
+_WAKE_LOG = _WakeLog()
+
+
