# Your house. These hold your network, your devices, your Wi-Fi's name, your people and the words
# you say, and they never belong in a repo, this one or a fork of it
house.toml
ha/context/about.local.md
hub/parakeet-words.local.txt
hub/digest.toml
hub/journal.toml

# the TV's own list and the state it had before (tools/tv.py), and the keeper as built on the Hub
tv/debloat.txt
tv/before.txt
tv/keeper/build/

# made from house.toml on every deploy (tools/build.py, tools/dashboard.py), into the house folder
# when it's this clone. ha/config/house/ and the dashboard are where older versions put them
.build/
ha/config/house/
ha/dashboards/home-hub.json
# what the privacy check stops on, for a house kept in the clone rather than a folder of its own
private-words.txt

# secrets that live elsewhere anyway: the token is in ~/.config/ha-hub/token, the ESPHome secrets
# on the Hub. These are here in case one gets copied in by mistake
*.token
secrets.yaml
esphome/build/
esphome/.esphome/

# working files
.tmp-*
.tmp-extras/
__pycache__/
.pytest_cache/
docs/figures/*.png
