      }
     },
     "grid_options": {
      "columns": 4
     },
     "badge_icon": "{{ 'mdi:play' if state_attr('sensor.tv_status', 'app') == 'YouTube' else '' }}",
     "badge_color": "green"
    },
    {
     "type": "custom:mushroom-template-card",
     "icon": "mdi:star-four-points",
     "primary": "Disney+",
     "color": "indigo",
     "vertical": true,
     "tap_action": {
      "action": "perform-action",
      "perform_action": "script.tv_open_app",
      "data": {
       "app": "Disney+"
      }
     },
     "grid_options": {
      "columns": 4
     },
     "badge_icon": "{{ 'mdi:play' if state_attr('sensor.tv_status', 'app') == 'Disney Plus' else '' }}",
     "badge_color": "green"
    },
    {
     "type": "custom:mushroom-template-card",
     "icon": "mdi:filmstrip",
     "primary": "Prime Video",
     "color": "light-blue",
     "vertical": true,
     "tap_action": {
      "action": "perform-action",
      "perform_action": "script.tv_open_app",
      "data": {
       "app": "Prime Video"
      }
     },
     "grid_options": {
      "columns": 4
     },
     "badge_icon": "{{ 'mdi:play' if state_attr('sensor.tv_status', 'app') == 'Prime Video' else '' }}",
