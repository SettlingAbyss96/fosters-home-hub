{#-
  The house's named settings, in one place, and one small list helper (docs/control.md).

  Home Assistant loads this file at startup and any template can use it:
    {% from 'control.jinja' import param %}
  Macros always hand back text, so numbers come out through | float and structures through
  | from_json. The control core (custom_components/house_control) reads its settings from param()
  too, so this stays the one table of them. The blocks that used to be here (the Bayes step,
  hysteresis, low-pass, rate, PID) and the light arbiter's gate and memory are Python there now.

    param(name)                         the house's named settings: hold times, thresholds, model numbers
    reminders_next(kind, data)          the reminders list, one event at a time (packages/reminders.yaml)
-#}

{#- The settings. Each has its reason next to it in docs/control.md. Priorities: the lower the number,
    the more it wins. 1 the alarm and safety, 2 me by hand (and the fell-asleep check, which has to
    beat a light I switched on before dozing off), 3 routines, 4 the mode's look, 5 background -#}
{%- macro param(name) -%}
{%- set p = {
  'priority_alarm': 1, 'priority_manual': 2, 'priority_routine': 3, 'priority_look': 4, 'priority_background': 5,
  'manual_hold_minutes': 180,
  'alarm_hold_minutes': 75,
  'command_settle_seconds': 10,
  'command_match_seconds': 120,
  'command_match_pct': 6,
  'asleep_on': 0.85,
  'asleep_max': 0.99,
  'asleep_off': 0.35,
  'asleep_hazard_late': 0.008,
  'asleep_hazard_evening': 0.003,
  'asleep_hazard_early': 0.003,
  'asleep_hazard_day': 0.0003,
  'asleep_hazard_max': 0.3,
  'asleep_wake_hazard': 0.002,
  'asleep_activity_ratio': 0.05,
  'empty_after_door_minutes': 5,
  'arrival_after_door_minutes': 10,
  'asleep_typing_ratio': 0.001,
  'ambient_level_dark': 80,
  'ambient_level_daylight': 50,
  'ambient_level_wind_down': 35,
  'kelvin_morning': 4000,
  'kelvin_evening': 2700,
  'kelvin_floor': 2700,
  'restart_kelvin': 4000,
  'daylight_full_elevation': 35,
  'wind_down_ramp_minutes': 60,
  'blend_fade_seconds': 60,
  'blend_ratio': 0.05,
  'blend_min_step': 2,
  'blend_mired_step': 3,
  'blend_minutes': 45,
  'calm_before_bed_minutes': 60,
  'bedtime_without_plan': '22:30',
  'wake_without_plan': '07:00',
  'stand_in_band': 15,
  'accent_on_from': 50,
} -%}
{#- the house's own settings, from [params] in house.toml (tools/build.py fills this line in) -#}
{%- set house = {} -%}
{{- house.get(name, p[name]) -}}
{%- endmacro -%}

{#- A list kept in a sensor's own attributes, one event at a time: the reminders
    (packages/reminders.yaml). Items are {id, message, due (epoch seconds)}. "add" puts one in,
    "done" takes one out by id, "clear" empties it. Kept in order of when they're due -#}
{%- macro reminders_next(kind, data) -%}
{%- set items = state_attr('sensor.reminders', 'items') or [] -%}
{%- if kind == 'add' and data.message is defined -%}
{%- set items = items + [{'id': (data.id | default(now().timestamp() | int)) | string, 'message': data.message | string,
                          'due': data.due | float(0)}] -%}
{%- elif kind == 'done' -%}
{%- set items = items | rejectattr('id', 'eq', data.id | default('') | string) | list -%}
{%- elif kind == 'clear' -%}
{%- set items = [] -%}
{%- endif -%}
{{- items | sort(attribute='due') | to_json -}}
{%- endmacro -%}
