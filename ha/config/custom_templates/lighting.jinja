{#-
  When Calm starts, for the templates that need it (sensor.natural_house_mode and the clock's move to
  Calm, packages/house_mode.yaml): the hour before tonight's planned bedtime. The light curve works
  it out with the bedtime it uses (custom_components/house_control/curve.py) and keeps it on
  sensor.light_curve. Until that's up after a restart, it's the hour before the bedtime the house
  goes by without a plan (bedtime_without_plan in control.jinja)
-#}
{%- macro calm_from() -%}
{%- from 'control.jinja' import param -%}
{%- set c = state_attr('sensor.light_curve', 'calm_from') -%}
{%- if c -%}{{- c -}}
{%- else -%}{{- (today_at(param('bedtime_without_plan')) - timedelta(days=0 if now().hour >= 12 else 1)
                 - timedelta(minutes=param('calm_before_bed_minutes') | int)).isoformat() -}}
{%- endif -%}
{%- endmacro -%}
